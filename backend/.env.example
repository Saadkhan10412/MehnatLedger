# =============================================================================
# MehnatLedger backend environment example.
#
# Copy this file to `.env` (which is git-ignored) and fill in real values.
# NEVER commit `.env`, and never paste real secret values into chat.
#
#   cd backend
#   cp .env.example .env
# =============================================================================

# --- Application -------------------------------------------------------------
# One of: development | test | production
ML_ENVIRONMENT=development

# One of: CRITICAL | ERROR | WARNING | INFO | DEBUG
ML_LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Local development default is a throwaway SQLite file. It is git-ignored.
ML_DATABASE_URL=sqlite+pysqlite:///./mehnatledger_dev.db
#
# For Supabase PostgreSQL (the chosen production target), copy the connection
# string from Supabase Dashboard -> Connect, and change the scheme to
# `postgresql+psycopg://` so SQLAlchemy uses the installed psycopg driver.
#
# Stationary servers (a VM or long-running container) should use the DIRECT
# connection string:
#   ML_DATABASE_URL=postgresql+psycopg://postgres:PASSWORD@db.PROJECTREF.supabase.co:5432/postgres
#
# NOTE from Supabase's docs: the direct connection resolves to an IPv6 address
# and will NOT work on an IPv4-only network. If that happens, use the Supavisor
# pooler in SESSION mode (port 5432) instead:
#   ML_DATABASE_URL=postgresql+psycopg://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Do not use transaction mode (port 6543) for Alembic migrations.
#
# Do not commit a real connection string: it contains a password.

# --- Supabase Auth (Phase 2; required for sign-in) ---------------------------
# Project URL, from Supabase Dashboard -> Project Settings -> Data API.
# This is not itself a secret, but keep all real values out of version control.
ML_SUPABASE_URL=
#
# Leave BLANK to verify tokens with the project's public JWKS endpoint, which is
# Supabase's recommended approach. Only set the JWT secret below if your project
# still uses the LEGACY shared JWT secret.
ML_SUPABASE_JWT_SECRET=
#
# Defaults are derived from ML_SUPABASE_URL when left blank:
#   issuer   = {ML_SUPABASE_URL}/auth/v1
#   jwks_url = {ML_SUPABASE_URL}/auth/v1/.well-known/jwks.json
ML_SUPABASE_JWT_ISSUER=
ML_SUPABASE_JWKS_URL=
# Supabase access tokens for signed-in users carry this audience by default.
ML_SUPABASE_JWT_AUDIENCE=authenticated

# --- Browser origins allowed to call this API (comma-separated) ---------------
ML_CORS_ORIGINS=http://localhost:5173

# --- Speech providers: Gnani (Phase 5, not yet integrated) --------------------
# Access, endpoints and quotas are NOT verified yet. Leave blank until the
# product owner confirms approved access and official API documentation.
# These values are read on the server only and are never sent to the browser.
ML_GNANI_STT_API_KEY=
ML_GNANI_STT_BASE_URL=
ML_GNANI_TTS_API_KEY=
ML_GNANI_TTS_BASE_URL=

# --- Reasoning / extraction provider (Phase 5, not yet selected) --------------
# One of: disabled | mock | local | live
# `disabled` and `mock` are the only modes available today. No reasoning
# provider has been approved, and no paid provider may be enabled.
ML_REASONING_MODE=disabled
ML_REASONING_BASE_URL=
ML_REASONING_API_KEY=

# --- Voice usage limits (enforced server-side once voice lands) ---------------
ML_VOICE_MAX_AUDIO_SECONDS=60
ML_VOICE_DAILY_DRAFTS_PER_USER=20
