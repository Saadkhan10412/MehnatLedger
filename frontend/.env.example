# =============================================================================
# MehnatLedger frontend environment example.
#
# Copy to `.env` (git-ignored) only if you need to override a value.
#
# WARNING: every variable prefixed with VITE_ is embedded into the browser
# bundle and is PUBLIC. Never put an API key, database password, token or any
# other secret in this file. Provider credentials belong in the backend's
# `.env` and are read on the server only.
# =============================================================================

# Base URL for the backend API. Leave empty to use same-origin requests, which
# is what the Vite dev proxy provides in development.
VITE_API_BASE_URL=
